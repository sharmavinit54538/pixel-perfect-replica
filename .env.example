# Environment variable reference — placeholder names only.
# Real values live in Lovable Cloud / server environment variables.
# NEVER commit real credentials to git.

# --- Supabase (managed by Lovable Cloud) ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Server-side only — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp / Meta Cloud API (server-side only) ---
# Meta access token (system-user/permanent token). Meta docs call this META_ACCESS_TOKEN.
WHATSAPP_API_KEY=
# Graph API base URL, e.g. https://graph.facebook.com/v21.0
WHATSAPP_API_BASE_URL=
# WhatsApp Business phone number ID (Meta docs: META_PHONE_NUMBER_ID).
WHATSAPP_PHONE_NUMBER_ID=

# --- Meta webhook (direct Meta Dashboard -> /api/public/whatsapp/webhook) ---
# Random string you invent yourself; paste the same value into the Meta
# Dashboard webhook "Verify token" field (Meta docs: META_VERIFY_TOKEN).
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (Meta App Dashboard -> Settings -> Basic). Used to validate
# X-Hub-Signature-256 on direct webhook POSTs (Meta docs: META_APP_SECRET).
WHATSAPP_APP_SECRET=
